    <string name="onboarding_welcome_title">Your phone and Drive, kept the same</string>
    <string name="onboarding_welcome_body">Pair a folder on this phone with a folder in Google Drive, or straight with your computer. Wasl keeps them matching, quietly, in both directions.</string>
