; Wasl's own installer strings, English and Arabic (installer.nsi includes this after MUI_LANGUAGE).
; Tauri's strings (reinstall page, WebView2, "app is running") come from Tauri's language files.

; Welcome
LangString wWelcomeTitle ${LANG_ENGLISH} "Welcome to Wasl ${VERSION}"
LangString wWelcomeTitle ${LANG_ARABIC} "مرحبًا بك في وصل ${VERSION}"
LangString wWelcomeText ${LANG_ENGLISH} "This installs the Wasl app, the wasld background service that keeps your folders in sync, and, if you want it, the wasl command for your terminal.$\r$\n$\r$\nIf Wasl is already installed, it is upgraded in place: your pairs, settings and history stay.$\r$\n$\r$\nClick Next to continue."
LangString wWelcomeText ${LANG_ARABIC} "يثبّت هذا تطبيق وصل، وخدمة wasld التي تبقي مجلداتك متزامنة في الخلفية، وأمر wasl للطرفية إن أردته.$\r$\n$\r$\nإن كان وصل مثبتًا فسيُرقّى في مكانه، وتبقى أزواجك وإعداداتك وسجلّك كما هي.$\r$\n$\r$\nانقر التالي للمتابعة."

; Install scope
LangString wScopeTitle ${LANG_ENGLISH} "Who is Wasl for?"
LangString wScopeTitle ${LANG_ARABIC} "لمن تثبّت وصل؟"
LangString wScopeSub ${LANG_ENGLISH} "Install Wasl for your account only, or for everyone who uses this computer."
LangString wScopeSub ${LANG_ARABIC} "ثبّت وصل لحسابك وحدك، أو لكل من يستخدم هذا الحاسوب."
LangString wScopeUser ${LANG_ENGLISH} "Just me (recommended, no administrator needed)"
LangString wScopeUser ${LANG_ARABIC} "لي وحدي (مُستحسن، لا يحتاج صلاحيات المسؤول)"
LangString wScopeUserNote ${LANG_ENGLISH} "Installs into your own folder and adds wasl to your PATH."
LangString wScopeUserNote ${LANG_ARABIC} "يثبّت في مجلدك أنت ويضيف wasl إلى PATH الخاص بك."
LangString wScopeAll ${LANG_ENGLISH} "Everyone who uses this computer (asks for administrator rights)"
LangString wScopeAll ${LANG_ARABIC} "كل من يستخدم هذا الحاسوب (يطلب صلاحيات المسؤول)"
LangString wScopeAllNote ${LANG_ENGLISH} "Installs into Program Files and adds wasl to the PATH of every account. Each person's sync data stays in their own profile."
LangString wScopeAllNote ${LANG_ARABIC} "يثبّت في Program Files ويضيف wasl إلى PATH لكل الحسابات. تبقى بيانات المزامنة لكل شخص في ملفه الشخصي."
LangString wScopeFound ${LANG_ENGLISH} "Wasl is already installed for $0. Keep this choice to upgrade it in place."
LangString wScopeFound ${LANG_ARABIC} "وصل مثبت حاليًا $0. أبقِ هذا الاختيار لترقيته في مكانه."
LangString wScopeFoundUser ${LANG_ENGLISH} "your account"
LangString wScopeFoundUser ${LANG_ARABIC} "لحسابك"
LangString wScopeFoundAll ${LANG_ENGLISH} "everyone"
LangString wScopeFoundAll ${LANG_ARABIC} "للجميع"
LangString wElevateFailed ${LANG_ENGLISH} "Wasl needs administrator rights to install for everyone. Choose 'Just me', or try again and allow the prompt."
LangString wElevateFailed ${LANG_ARABIC} "يحتاج وصل صلاحيات المسؤول ليُثبَّت للجميع. اختر «لي وحدي» أو أعد المحاولة ووافق على الطلب."
LangString wNeedsAdmin ${LANG_ENGLISH} "Installing for everyone needs an elevated prompt. Run the installer as administrator, or pass /CURRENTUSER.$\n"
LangString wNeedsAdmin ${LANG_ARABIC} "التثبيت للجميع يحتاج صلاحيات المسؤول. شغّل المثبّت كمسؤول أو أضف /CURRENTUSER.$\n"

; Components
LangString wCompSub ${LANG_ENGLISH} "Choose which parts of Wasl to install."
LangString wCompSub ${LANG_ARABIC} "اختر ما تريد تثبيته من وصل."
LangString wSecCore ${LANG_ENGLISH} "Wasl app and background service"
LangString wSecCore ${LANG_ARABIC} "تطبيق وصل وخدمة الخلفية"
LangString wSecCoreDesc ${LANG_ENGLISH} "The Wasl window and tray icon, and wasld, the service that syncs your folders. Required."
LangString wSecCoreDesc ${LANG_ARABIC} "نافذة وصل وأيقونته في شريط المهام، وwasld الخدمة التي تزامن مجلداتك. مطلوب."
LangString wSecCli ${LANG_ENGLISH} "Command-line tool 'wasl'"
LangString wSecCli ${LANG_ARABIC} "أداة سطر الأوامر wasl"
LangString wSecCliDescUser ${LANG_ENGLISH} "Adds the install folder to your PATH, so 'wasl' works in any new terminal. No restart needed."
LangString wSecCliDescUser ${LANG_ARABIC} "يضيف مجلد التثبيت إلى PATH الخاص بك ليعمل الأمر wasl في أي طرفية جديدة، دون إعادة تشغيل."
LangString wSecCliDescAll ${LANG_ENGLISH} "Adds the install folder to the PATH of every account on this computer, so 'wasl' works in any new terminal. No restart needed."
LangString wSecCliDescAll ${LANG_ARABIC} "يضيف مجلد التثبيت إلى PATH لكل الحسابات على هذا الحاسوب ليعمل الأمر wasl في أي طرفية جديدة، دون إعادة تشغيل."
LangString wSecStartMenu ${LANG_ENGLISH} "Start menu shortcut"
LangString wSecStartMenu ${LANG_ARABIC} "اختصار في قائمة ابدأ"
LangString wSecStartMenuDesc ${LANG_ENGLISH} "Adds Wasl to the Start menu."
LangString wSecStartMenuDesc ${LANG_ARABIC} "يضيف وصل إلى قائمة ابدأ."
LangString wSecDesktop ${LANG_ENGLISH} "Desktop shortcut"
LangString wSecDesktop ${LANG_ARABIC} "اختصار على سطح المكتب"
LangString wSecDesktopDesc ${LANG_ENGLISH} "Puts a Wasl shortcut on your desktop."
LangString wSecDesktopDesc ${LANG_ARABIC} "يضع اختصارًا لوصل على سطح المكتب."
LangString wSecAutostart ${LANG_ENGLISH} "Start Wasl when I sign in"
LangString wSecAutostart ${LANG_ARABIC} "شغّل وصل عند تسجيل الدخول"
LangString wSecAutostartDesc ${LANG_ENGLISH} "Starts wasld when you sign in to Windows, so syncing carries on without opening the app. You can change this later in Wasl's settings."
LangString wSecAutostartDesc ${LANG_ARABIC} "يشغّل wasld عند تسجيل دخولك إلى ويندوز لتستمر المزامنة دون فتح التطبيق. يمكنك تغيير هذا لاحقًا من إعدادات وصل."

; Progress
LangString wStopping ${LANG_ENGLISH} "Stopping Wasl in $INSTDIR..."
LangString wStopping ${LANG_ARABIC} "إيقاف وصل في $INSTDIR..."
LangString wPathAdd ${LANG_ENGLISH} "Adding $INSTDIR to PATH..."
LangString wPathAdd ${LANG_ARABIC} "إضافة $INSTDIR إلى PATH..."
LangString wPathRemove ${LANG_ENGLISH} "Removing $INSTDIR from PATH..."
LangString wPathRemove ${LANG_ARABIC} "إزالة $INSTDIR من PATH..."
LangString wPathFailed ${LANG_ENGLISH} "Could not add Wasl to PATH. To use wasl in a terminal, add $INSTDIR to PATH yourself."
LangString wPathFailed ${LANG_ARABIC} "تعذّرت إضافة وصل إلى PATH. لتستخدم wasl في الطرفية، أضف $INSTDIR إلى PATH بنفسك."
LangString wRemovingOld ${LANG_ENGLISH} "Removing the old version..."
LangString wRemovingOld ${LANG_ARABIC} "إزالة النسخة القديمة..."
LangString wMsiFailed ${LANG_ENGLISH} "The older Wasl (installed from an .msi) could not be removed, so no files were changed. Remove it in Settings > Apps, then run this installer again."
LangString wMsiFailed ${LANG_ARABIC} "تعذّرت إزالة نسخة وصل الأقدم (المثبتة من ملف .msi)، فلم يتغير أي ملف. أزلها من الإعدادات > التطبيقات ثم شغّل هذا المثبّت من جديد."
LangString wAutostartOn ${LANG_ENGLISH} "Turning on start at sign-in..."
LangString wAutostartOn ${LANG_ARABIC} "تفعيل التشغيل عند تسجيل الدخول..."
LangString wRestarting ${LANG_ENGLISH} "Starting Wasl again..."
LangString wRestarting ${LANG_ARABIC} "إعادة تشغيل وصل..."

; Finish
LangString wFinishTitle ${LANG_ENGLISH} "Wasl is ready"
LangString wFinishTitle ${LANG_ARABIC} "وصل جاهز"
LangString wFinishText ${LANG_ENGLISH} "Wasl ${VERSION} is installed in $INSTDIR."
LangString wFinishText ${LANG_ARABIC} "ثُبّت وصل ${VERSION} في $INSTDIR."
LangString wFinishTextCli ${LANG_ENGLISH} "Wasl ${VERSION} is installed in $INSTDIR.$\r$\n$\r$\nThe wasl command works in any terminal you open from now on. Try: wasl status"
LangString wFinishTextCli ${LANG_ARABIC} "ثُبّت وصل ${VERSION} في $INSTDIR.$\r$\n$\r$\nيعمل الأمر wasl في أي طرفية تفتحها من الآن. جرّب: wasl status"
LangString wLaunch ${LANG_ENGLISH} "Launch Wasl"
LangString wLaunch ${LANG_ARABIC} "شغّل وصل"
LangString wTryCli ${LANG_ENGLISH} "Open a terminal and try wasl status"
LangString wTryCli ${LANG_ARABIC} "افتح طرفية وجرّب wasl status"

; Reinstall page
LangString wUpgradeLong ${LANG_ENGLISH} "Wasl $R4 is installed. It will be upgraded to ${VERSION} in place: your pairs, settings and history stay, and wasld is stopped and started again."
LangString wUpgradeLong ${LANG_ARABIC} "وصل $R4 مثبت. سيُرقّى إلى ${VERSION} في مكانه: تبقى أزواجك وإعداداتك وسجلّك، ويُوقف wasld ثم يُشغّل من جديد."
LangString wUpgradeInPlace ${LANG_ENGLISH} "Upgrade in place (recommended)"
LangString wUpgradeInPlace ${LANG_ARABIC} "رقِّه في مكانه (مُستحسن)"
LangString wUninstallFirst ${LANG_ENGLISH} "Uninstall the old version first, then install (your data stays)"
LangString wUninstallFirst ${LANG_ARABIC} "أزل النسخة القديمة أولًا ثم ثبّت (تبقى بياناتك)"

; Uninstaller
LangString wDeleteData ${LANG_ENGLISH} "Also delete my Wasl data on this computer: pairs, settings, history and keys"
LangString wDeleteData ${LANG_ARABIC} "احذف أيضًا بيانات وصل على هذا الحاسوب: الأزواج والإعدادات والسجل والمفاتيح"
LangString wKeepDataShared ${LANG_ENGLISH} "Your Wasl data is kept: another copy of Wasl on this computer uses it."
LangString wKeepDataShared ${LANG_ARABIC} "تُبقى بيانات وصل لأن نسخة أخرى من وصل على هذا الحاسوب تستخدمها."
LangString wKeepDataOtherUser ${LANG_ENGLISH} "Your Wasl data is kept: this uninstaller runs as another account. To delete the data, uninstall from your own account."
LangString wKeepDataOtherUser ${LANG_ARABIC} "تُبقى بيانات وصل لأن أداة الإزالة تعمل بحساب آخر. لحذف البيانات، أزل وصل من حسابك أنت."
LangString wUnElevateFailed ${LANG_ENGLISH} "Wasl is installed for everyone, so removing it needs administrator rights. Nothing was removed. Try again and allow the prompt."
LangString wUnElevateFailed ${LANG_ARABIC} "وصل مثبت للجميع، فإزالته تحتاج صلاحيات المسؤول. لم يُزل شيء. أعد المحاولة ووافق على الطلب."
