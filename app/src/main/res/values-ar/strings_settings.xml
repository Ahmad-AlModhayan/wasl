    <!-- About -->
    <string name="about_title">حول</string>
    <string name="about_version">الإصدار %1$s</string>
    <string name="about_intro">يُبقي وصل المجلدات على هذا الهاتف والمجلدات في Google Drive متطابقة، في الاتجاهين. يبقى هادئًا ما دام كل شيء متوافقًا، ويقول بدقة ما حدث حين لا يكون كذلك، ولا يعرض إعلانًا أو إلحاحًا أبدًا.</string>
    <string name="about_promises">ثلاثة وعود</string>
    <string name="about_promise_preview_title">ترى التغييرات قبل أن تحدث</string>
    <string name="about_promise_preview_body">يبدأ كل ربط جديد بمعاينة، وينتظر الحذف الكبير موافقتك.</string>
    <string name="about_promise_bin_title">لا يضيع شيء لمدة 30 يومًا</string>
    <string name="about_promise_bin_body">تنتظر الملفات المُزالة والمستبدلة في سلة المحذوفات أو في إصدارات الملف.</string>
    <string name="about_promise_private_title">بلا إعلانات ولا تتبع</string>
    <string name="about_promise_private_body">تنتقل ملفاتك إلى Drive الخاص بك وإلى أجهزتك. ولا مكان غيرها.</string>
    <string name="about_how_sync_works">كيف تعمل المزامنة</string>
    <string name="about_step_compare">لكل ملف، يقارن الربط ثلاثة أشياء: نسخة الهاتف، ونسخة Drive، وحالة النسختين بعد آخر مزامنة.</string>
    <string name="about_step_changes">لا ينتقل إلا ما تغيّر. تُنسخ الملفات الجديدة والمعدّلة، والملف المحذوف من طرف يذهب إلى سلة المحذوفات في الطرف الآخر.</string>
    <string name="about_step_conflicts">عندما يتغير الملف نفسه على الطرفين، تُحفظ النسختان وينتظرك التعارض في المشكلات.</string>
    <string name="about_step_large_deletes">قبل الحذف الكبير، أو أول مزامنة إلى مجلد فيه ملفات من قبل، يتوقف وصل ويعرض ما سيحدث.</string>
    <string name="about_step_schedule">تُفحص الروابط حسب جدول، وخلال ثوانٍ من أي تغيير عند تفعيل المزامنة الفورية. تصل ملفات Google Docs إلى الهاتف نسخًا للقراءة فقط.</string>
    <string name="about_more">المزيد</string>
    <string name="about_settings_summary">الإعدادات الافتراضية والأمان والمظهر</string>
    <string name="about_automation_summary">أوامر Tasker وMacroDroid وadb</string>
    <string name="about_credits">من صنع Kahf Labs. إرشادات العمل في الخلفية لكل شركة هواتف مأخوذة من dontkillmyapp.com.</string>

