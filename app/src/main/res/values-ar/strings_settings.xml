    <string name="settings_automation_sheet_extra">مع القيمة الإضافية النصية \"%1$s\" = %2$s</string>
    <string name="settings_automation_sheet_ignored">يتجاهل وصل البث الذي لا يحملها، ويتجاهل كل بث ما دام خيار السماح بالأتمتة متوقفًا.</string>
