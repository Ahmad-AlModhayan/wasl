{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The macOS Settings window (#68): events, dragging the window by its tabs, titling and sizing itself to its pane, and only the app commands its page calls (src/commands.test.ts checks them). No folder picker.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "allow-app-info",
    "allow-open-site-page",
    "allow-check-update",
    "allow-open-download",
    "allow-daemon-state",
    "allow-status",
    "allow-setting",
    "allow-set-setting",
    "allow-set-start-at-login",
    "allow-add-account",
    "allow-remove-account",
    "allow-set-tray-visible"
  ]
}
