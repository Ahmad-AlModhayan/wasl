    <string name="settings_privacy_sign_in_title">تسجيل الدخول</string>
    <string name="settings_privacy_sign_in_body">تتولى خدمات Google Play تسجيل الدخول. لا يرى وصل كلمة مرور Google أبدًا.</string>
    <string name="settings_privacy_location_title">الموقع</string>
