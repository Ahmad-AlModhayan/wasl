        { "from": "open", "to": "staged", "label": "Agent exits\n(backups saved)", "lx": 330, "ly": 144 },
        { "from": "staged", "to": "committed", "fromSide": "top", "toSide": "left", "via": [{ "x": 484, "y": 124 }], "label": "Out-of-band confirm (256-bit)", "tone": "positive", "lx": 566, "ly": 98 },
        { "from": "staged", "to": "reverted", "fromSide": "bottom", "toSide": "left", "via": [{ "x": 484, "y": 264 }], "label": "wasl agent revert (skip user edits)", "tone": "neutral", "lx": 560, "ly": 294 },
        { "from": "committed", "to": "reverted", "fromSide": "bottom", "toSide": "top", "label": "Inverse oplog revert", "dashed": true, "lx": 760, "ly": 194 },
        { "from": "committed", "to": "end1", "fromSide": "right", "toSide": "left" },
        { "from": "reverted", "to": "end2", "fromSide": "right", "toSide": "left" }
      ]
