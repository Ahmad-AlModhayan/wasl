{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Wasl's own window may call: events, the folder picker, dragging the window by its toolbar, and every one of the app's commands (build.rs lists them).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-app-info",
    "allow-open-site-page",
    "allow-check-update",
    "allow-open-download",
    "allow-daemon-state",
    "allow-start-daemon",
    "allow-set-tray-text",
    "allow-set-start-at-login",
    "allow-status",
    "allow-pairs",
    "allow-create-pair",
    "allow-delete-pair",
    "allow-set-paused",
    "allow-show-pair-folder",
    "allow-preview",
    "allow-sync",
    "allow-sync-all",
    "allow-cancel",
    "allow-approve-once",
    "allow-blocked-plan",
    "allow-runs",
    "allow-run-events",
    "allow-open-conflicts",
    "allow-conflict-details",
    "allow-resolve-conflict",
    "allow-undo-conflict",
    "allow-agent-changesets",
    "allow-agent-changeset",
    "allow-agent-diff",
    "allow-agent-accept",
    "allow-agent-revert",
    "allow-agent-end",
    "allow-agent-setup",
    "allow-bin-entries",
    "allow-restore-bin",
    "allow-delete-bin-forever",
    "allow-empty-bin",
    "allow-accounts",
    "allow-add-account",
    "allow-remove-account",
    "allow-drive-folders",
    "allow-resolve-drive-path",
    "allow-devices",
    "allow-remove-device",
    "allow-connect-device",
    "allow-share-pair",
    "allow-share-code",
    "allow-unshare-pair",
    "allow-sharing",
    "allow-share-with",
    "allow-offers",
    "allow-decline-offer",
    "allow-accept-offer",
    "allow-keep-device",
    "allow-invite-device",
    "allow-join-device",
    "allow-pairing-status",
    "allow-confirm-pairing",
    "allow-cancel-pairing",
    "allow-views",
    "allow-add-view",
    "allow-remove-view",
    "allow-set-view-enabled",
    "allow-set-view-cache-limit",
