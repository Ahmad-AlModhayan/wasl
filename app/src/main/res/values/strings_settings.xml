    <!-- Settings: choice dialogs -->
    <string name="settings_interval_intro">How often every pair is checked in the background. Android may run a check a little later to save battery.</string>
    <string name="settings_poll_title">Drive change check</string>
    <string name="settings_poll_intro">How often instant sync asks Drive for changes made on the web or on other devices.</string>
    <string name="settings_battery_intro">New pairs skip scheduled syncs below this level, unless the phone is charging.</string>
    <string name="settings_concurrency_title">Parallel transfers</string>
    <string name="settings_concurrency_intro">Files copied at the same time. Fewer is gentler on slow or shared connections.</string>
    <string name="settings_bandwidth_title">Bandwidth limit</string>
    <string name="settings_bandwidth_intro">The most Wasl uses for uploads and downloads together.</string>
    <string name="settings_conflict_title">When both sides change</string>
    <string name="settings_conflict_intro">What new pairs do when the same file changed on the phone and on Drive since the last sync.</string>
    <string name="settings_bin_title">Recycle bin keeps files</string>
    <string name="settings_bin_intro">Files a sync removes or replaces on this phone wait in the recycle bin this long. Drive\'s own bin keeps files for 30 days.</string>
    <string name="settings_versions_title">Versions kept on this phone</string>
    <string name="settings_versions_intro">Older copies of a file that a sync replaced on this phone. Drive keeps its own versions as well.</string>
    <string name="settings_history_intro">Past syncs and their log lines older than this are cleared.</string>
