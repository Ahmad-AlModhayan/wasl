<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of Wasl's leaves the phone through cloud backup or device-to-device transfer: tokens,
    vault keys, the sync database and settings stay put (security review 2026-10). allowBackup is
    false as well; Android 12+ reads these rules for device transfer regardless of that flag.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
