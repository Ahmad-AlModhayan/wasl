    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">Wasl keeps folders on this phone and folders in your Google Drive the same, in both directions. It stays quiet while everything is in step, says exactly what happened when something isn\'t, and never shows an ad or a nag.</string>
    <string name="about_promises">Three promises</string>
    <string name="about_promise_preview_title">You see changes before they happen</string>
    <string name="about_promise_preview_body">Every new pair starts with a preview, and a large delete waits for your OK.</string>
    <string name="about_promise_bin_title">Nothing is lost for 30 days</string>
    <string name="about_promise_bin_body">Removed and replaced files wait in the recycle bin or in the file\'s versions.</string>
    <string name="about_promise_private_title">No ads, no tracking</string>
    <string name="about_promise_private_body">Your files go to your Drive and your own devices. Nowhere else.</string>
    <string name="about_how_sync_works">How sync works</string>
    <string name="about_step_compare">For every file, a pair compares three things: the phone copy, the Drive copy, and how both looked after the last sync.</string>
    <string name="about_step_changes">Only what changed moves. New and edited files are copied; a file removed on one side goes to the recycle bin on the other.</string>
    <string name="about_step_conflicts">When the same file changed on both sides, both copies are kept and the conflict waits for you in Problems.</string>
    <string name="about_step_large_deletes">Before a large delete, or a first sync into a folder that already has files, Wasl stops and shows what would happen.</string>
    <string name="about_step_schedule">Pairs are checked on a schedule, and within seconds of a change when instant sync is on. Google Docs come to the phone as read-only copies.</string>
    <string name="about_more">More</string>
    <string name="about_settings_summary">Defaults, safety and appearance</string>
    <string name="about_automation_summary">Tasker, MacroDroid and adb commands</string>
    <string name="about_credits">Made by Kahf Labs. Background guides for phone makers come from dontkillmyapp.com.</string>

