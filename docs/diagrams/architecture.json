        { "id": "committed", "cx": 760, "cy": 124, "w": 180, "h": 66, "tone": "positive", "label": "committed", "sub": "Sync resumes for keys" },
        { "id": "reverted", "cx": 760, "cy": 264, "w": 180, "h": 66, "tone": "neutral", "label": "reverted", "sub": "Bytes & mtimes restored" },
        { "id": "end1", "kind": "end", "cx": 916, "cy": 124 },
        { "id": "end2", "kind": "end", "cx": 916, "cy": 264 }
