<resources>
    <style name="Theme.DriveSync" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ds_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch screen: the app icon (cream mark on the navy tile), then the app theme. -->
    <style name="Theme.DriveSync.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ds_brand_tile</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DriveSync</item>
    </style>
</resources>
