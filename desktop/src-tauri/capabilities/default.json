    "allow-title-bar-double-click",
    "allow-tray-hide",
    "allow-tray-fit",
    "allow-tray-open",
    "allow-tray-menu",
    "allow-set-tray-visible",
    "allow-update-pair",
    "allow-deletion-review",
    "allow-restore-deletions",
    "allow-undo-bin-restore",
    "allow-open-settings",
    "allow-system-accent",
    "allow-is-folder",
    "allow-take-opened-folder"
  ]
