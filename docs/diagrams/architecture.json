    {
      "id": "uml-apply-sequence",
      "kind": "sequence",
      "badge": "UML · SEQUENCE",
      "title": "Wasl — Crash-Safe Apply Boundary",
      "subtitle": "Single serialization point per pair: stage → fsync → re-stat vs plan → copy old file to 30-day bin → atomic rename → commit baseline",
      "participants": [
        { "id": "plan", "label": "Planner / P2P", "sub": "wasl-core", "tone": "info" },
        { "id": "locks", "label": "PairLocks", "sub": "Per-Pair Mutex", "tone": "warning" },
        { "id": "apply", "label": "Apply Boundary", "sub": "wasl-engine::apply", "tone": "primary" },
        { "id": "fs", "label": "Local FS", "sub": "wasl-fs · Disk" },
        { "id": "store", "label": "wasl-store", "sub": "SQLite + Bin Index" }
      ],
      "steps": [
        { "from": "plan", "to": "locks", "label": "Acquire per-pair mutex" },
        { "from": "locks", "to": "apply", "label": "Execute planned write / delete" },
        { "from": "apply", "to": "apply", "label": "Validate path (NameRules NFC)" },
        { "from": "apply", "to": "fs", "label": "Write staged temp file + fsync" },
        { "from": "apply", "to": "fs", "label": "Re-stat target (as_planned check)" },
        { "type": "frame_start", "kind": "ALT", "label": "Target modified after planning", "tone": "warning" },
        { "from": "apply", "to": "plan", "label": "Abort untouched (CHANGED_SINCE_PLANNED)", "dashed": true, "tone": "warning" },
        { "type": "frame_else", "label": "Target unchanged since plan" },
        { "from": "apply", "to": "fs", "label": "Copy previous file to 30-day bin" },
        { "from": "apply", "to": "store", "label": "Index bin entry (<= 5 versions/key)" },
        { "from": "apply", "to": "fs", "label": "Atomic rename staged -> target", "tone": "positive" },
        { "from": "apply", "to": "store", "label": "Commit updated baseline row", "tone": "positive" },
        { "type": "frame_end" },
        { "from": "locks", "to": "plan", "label": "Release per-pair mutex", "dashed": true }
      ]
    },
