{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "externalBin": [
      "binaries/wasld",
      "binaries/wasl"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/wasl-hooks.nsh",
        "installMode": "both",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/art/sidebar.bmp",
        "headerImage": "windows/art/header.bmp",
        "compression": "lzma"
      }
    },
    "macOS": {
      "files": {
        "PlugIns/WaslFileProvider.appex": "../macos-provider/build/WaslFileProvider.appex",
        "MacOS/wasl-fileprovider": "../macos-provider/build/wasl-fileprovider"
      }
    }
  }
}
