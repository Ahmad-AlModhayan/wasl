---
/* wasl.kahflabs.com home. Screens are rendered from the "Wasl redesign" canvas.
   The "How Wasl uses your Google Drive" section is what Google's OAuth review reads on the home page: keep it. */
import Base from '@kahf/design/layouts/Base.astro';
import Button from '@kahf/design/components/Button.astro';
import Eyebrow from '@kahf/design/components/Eyebrow.astro';
import SectionHead from '@kahf/design/components/SectionHead.astro';
import StatusChip from '@kahf/design/components/StatusChip.astro';
import SpecList from '@kahf/design/components/SpecList.astro';
import Phone from '@kahf/design/components/Phone.astro';
import Strengths from '@kahf/design/components/Strengths.astro';
import Steps from '@kahf/design/components/Steps.astro';
import Icon from '@kahf/design/components/Icon.astro';
import { path, KAHF, type Lang } from '@kahf/design/lib/product';
import { P, GET } from './product';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const scope = 'https://www.googleapis.com/auth/drive';
const policy = 'https://developers.google.com/terms/api-services-user-data-policy';
const perms = 'https://myaccount.google.com/permissions';

const T = ar ? {
  title: 'وصل · مزامنةٌ تستأذن قبل أن تتصرّف.',
  description: 'اختر مجلدًا على هاتفك وآخر في Google Drive، ويُبقيهما وصل متطابقين. يعرض كل تغيير قبل المزامنة الأولى، ويتوقف قبل أي حذفٍ كبير، ويحتفظ بالملفات المستبدلة ٣٠ يومًا.',
  h1: 'مزامنةٌ تستأذن قبل أن تتصرّف.',
  lede: 'اختر مجلدًا على هاتفك وآخر في Google Drive، ويُبقيهما وصل متطابقين. يعرض كل تغيير قبل المزامنة الأولى، ويتوقف قبل أي حذفٍ كبير، ويحتفظ بالملفات المستبدلة ٣٠ يومًا. ملفاتك تنتقل بين هاتفك وحسابك، ولا تمرّ بأي مكانٍ آخر.',
  more: 'كيف يعمل',
  note: 'الوصل: ما يجعل المكانين مكانًا واحدًا. وشعار وصل سهمان يُغلقان دائرة واحدة بين الهاتف والسحابة.',
  hero: [['main', 'شاشة الأزواج في وصل: تنبيه «٣٤ حذفًا ينتظرك»، ومجلد الكاميرا يتزامن عند ٦٢٪، والمستندات متزامنة'], ['dry-run', 'معاينة المزامنة الأولى لمجلد الكاميرا: ٣٣٤ ملفًا إلى Drive، و٠ إلى الهاتف، و٠ إلى سلة المحذوفات، وتعارضان محفوظان']],
  strengthsLabel: 'ثلاث ضمانات',
  strengths: [
    { icon: 'visibility', claim: 'لا شيء يتغيّر قبل أن تراه.', because: 'كل زوجٍ جديد يبدأ بمعاينةٍ لكل رفعٍ وتنزيلٍ وحذف، ولا تبدأ المزامنة الأولى إلا حين تضغط «ابدأ».' },
    { icon: 'delete', claim: 'الحذف الكبير ينتظرك.', because: 'إن كانت مزامنةٌ ستحذف أكثر من ٢٠ ملفًا أو ٥٪ من مجلد، توقّفت وسألتك. وكل ما يُحذف أو يُستبدل ينتظر في السلة ٣٠ يومًا.' },
    { icon: 'sync_problem', claim: 'التعديلان ينجوان.', because: 'إن تغيّر الملف على الهاتف وعلى Drive معًا، احتفظ وصل بالنسختين حتى تختار أنت. لا شيء يُستبدل بالتخمين.' },
  ],
  howEyebrow: 'كيف يعمل',
  howTitle: 'زوجٌ واحد، أربع خطوات.',
  howLede: 'كل زوج يربط مجلدًا على الهاتف بمجلدٍ في Drive، بقواعده هو. أنشئ ما تشاء من الأزواج، ولكلٍّ منها اتجاهه ووقته.',
  steps: [
    { key: '٠١ · الزوج', title: 'مجلدٌ هنا، ومجلدٌ هناك.', body: 'سمِّ الزوج، واختر مجلد الهاتف ومجلد Drive، ثم الاتجاه: في الاتجاهين، أو من الهاتف إلى Drive، أو من Drive إلى الهاتف. ويشمل ذلك الأقراص المشتركة.', screen: 'pair-editor', alt: 'زوج جديد باسم «الكاميرا»: المجلد /DCIM/Camera على الهاتف، وMy Drive/Photos/Camera على Drive، ووضع المزامنة في الاتجاهين' },
    { key: '٠٢ · المعاينة', title: 'المزامنة الأولى، قبل أن تجري.', body: 'يعدّ وصل كل ما سيحدث: كم ملفًا يُرفع، وكم يُنزَّل، وما يذهب إلى السلة، وأين التعارضات. وتتصفّح القائمة ملفًا ملفًا قبل أن تضغط «ابدأ».', screen: 'dry-run', alt: 'معاينة المزامنة الأولى: ٣٣٤ إلى Drive، و٠ إلى الهاتف، وقائمة الملفات بما سيحدث لكلٍّ منها' },
    { key: '٠٣ · القواعد', title: 'يتزامن حين يناسبك.', body: 'خلال ثوانٍ من أي تغيير، أو كل ١٥ دقيقة، مع قواعد مثل Wi‑Fi فقط أو أثناء الشحن فقط. وبيانات الجوال لا تُستخدم ما لم تسمح بها.', screen: 'pair-detail', alt: 'تفاصيل زوج الكاميرا: الوضع في الاتجاهين، والتوقيت فوري، وWi‑Fi فقط مفعّل، وطلب الموافقة على الحذف الكبير' },
    { key: '٠٤ · الاستعادة', title: 'التراجع قريبٌ دائمًا.', body: 'سلة وصل تحفظ ما حُذف أو استُبدل ٣٠ يومًا، من الهاتف أو من Drive، وتعيده بلمسة. وسجلّ نسخ Drive لكل ملف على بُعد لمسة أخرى.', screen: 'recycle-bin', alt: 'سلة المحذوفات: ٤١ ملفًا محفوظة ٣٠ يومًا، مع زر «استعادة» بجانب كل ملف' },
  ],
  safetyKicker: 'ما يحدث حين يختفي مجلدٌ فجأة',
  safetyTitle: '٣٤ حذفًا ينتظرك.',
  safetyBody: 'فقد مجلد الكاميرا ٣٤ ملفًا دفعةً واحدة، أي ٦٪ منه. توقّف وصل، ولم يحذف شيئًا، وسألك: أعِدها إلى الهاتف، أو أكّد حذفها من Drive أيضًا. وأيّ الجوابين يمكن التراجع عنه ٣٠ يومًا.',
  safety: [['review-deletions', 'مراجعة الحذف: «٣٤ ملفًا اختفت من الهاتف»، وتنبيه «لم يُحذف شيء»، وزرّا «استعادة إلى الهاتف» و«احذف من Drive أيضًا»'], ['conflict', 'تعارض في report-final.docx: نسخة الهاتف ونسخة Drive جنبًا إلى جنب، وخيار «الاحتفاظ بالنسختين»']],
  toolsEyebrow: 'الأدوات',
  toolsTitle: 'لمن يريد أكثر.',
  toolsLede: 'خزائن مشفّرة، وسجلّ نسخ، وتشخيصٌ يشرح ما حدث بلغةٍ مفهومة. كلها هادئة حتى تحتاج إليها.',
  tools: [['vaults', 'خزائن مشفّرة', 'الخزائن: أزواج تُشفَّر على الهاتف قبل الرفع، فلا يرى Drive الأسماء ولا المحتوى'], ['versions', 'سجلّ النسخ', 'سجلّ نسخ budget-2026.xlsx: سبع نسخ، وزر «استعادة» لكلٍّ منها'], ['diagnostics', 'التشخيص', 'التشخيص: خمسة فحوص من ستة ناجحة، وسجلّ آخر ٢٤ ساعة'], ['permissions', 'الأذونات', 'ما يحتاجه وصل: Google Drive والوصول إلى الملفات مطلوبان، والإشعارات والعمل في الخلفية اختياريان']],
  driveEyebrow: 'حسابك في Google Drive',
  driveTitle: 'كيف يستخدم وصل حسابك في Google Drive.',
  drive: {
    scopeP1: 'حين تضيف حساب Google يطلب وصل إذنًا واحدًا: أن يرى ملفات Google Drive وينشئها ويعدّلها ويحذفها (',
    scopeP2: ').',
    whyH: 'لماذا يحتاج إلى الوصول الكامل',
    why: 'أنت تختار مجلدات موجودة أصلًا في Drive، بما فيها الأقراص المشتركة والملفات المضافة من حاسوب أو من الويب. والأذونات الأضيق لا تصل إلا إلى الملفات التي أنشأها التطبيق نفسه، فلا تكفي لمزامنة مجلدٍ قائم.',
    doesH: 'ما يفعله بهذا الإذن',
    does: [
      'يقرأ قائمة مجلدات Drive لتختار منها ما تقرنه.',
      'يرفع الملفات ويُنزّلها داخل المجلدات التي قرنتها فقط، ويصدّر ملفات Google Docs فيها نسخًا بصيغ Word وExcel وPowerPoint وPDF على هاتفك.',
      'ينقل ما تحذفه المزامنة إلى سلة Drive، ويعرض النسخ السابقة لتستعيد ما تشاء.',
      'يقرأ مساحة التخزين ليعرض المتاح.',
      'إن تصفّحت Drive من تطبيق الملفات في هاتفك، فلا يفتح إلا ما تفتحه أنت.',
      'إن فعّلت النسخ الاحتياطي للإعدادات، يحفظ ملفًا صغيرًا يصف أزواجك وإعداداتك، لا محتوى ملفاتك، في مجلد البيانات المخفي للتطبيق في Drive.',
    ],
    whereH: 'أين تذهب بياناتك',
    where: 'تنتقل الملفات مباشرةً بين هاتفك وخوادم Google عبر HTTPS. ليس لوصل خوادم خاصة، ولا يحوي شيفرة تحليلات ولا إعلانات ولا تقارير أعطال. ولا تُباع بياناتك، ولا تُشارك، ولا تُستخدم في تدريب نماذج الذكاء الاصطناعي.',
    limited1: 'استخدام وصل للمعلومات المستلمة من واجهات Google ونقلها يلتزم ',
    limitedLink: 'سياسة بيانات المستخدم لخدمات Google API',
    limited2: '، بما في ذلك متطلبات الاستخدام المحدود.',
    revoke1: 'يمكنك إلغاء الوصول متى شئت: من داخل التطبيق في «الحسابات» › «قطع الاتصال»، أو من حسابك في Google على ',
    revoke2: '. وتفاصيل ذلك في ',
    policy: 'سياسة الخصوصية',
  },
  privacyEyebrow: 'الخصوصية',
  privacyTitle: 'ملفاتك تذهب إلى حسابك، ولا مكان سواه.',
  privacyLede: 'وصل أداة، لا خدمة: يعمل على هاتفك، ويتحدث إلى Google مباشرة، ولا يعرف عنك أحدٌ سواك.',
  facts: [
    { term: 'التخزين', value: 'حسابك أنت في Google Drive' },
    { term: 'الخوادم', value: 'لا خوادم لنا. الملفات تنتقل بين هاتفك وGoogle عبر HTTPS' },
    { term: 'التتبّع', value: 'بلا إعلانات، ولا تحليلات، ولا تقارير أعطال' },
    { term: 'التشفير', value: 'اختياري لكل زوج، على الهاتف، بعبارة مرورٍ لا تغادره' },
    { term: 'يتطلب', value: 'أندرويد ١١ أو أحدث' },
    { term: 'الحالة', value: 'تجريبي، والوصول إليه بطلب', tone: 'accent' },
  ],
  closingTitle: 'ابدأ بمجلدٍ واحد.',
  closingBody: 'الكاميرا مكانٌ جيد للبداية: زوجٌ واحد، ومعاينة، وضغطة «ابدأ». وإن لم يعجبك ما رأيت في المعاينة، فلم يتغيّر شيء.',
} : {
  title: 'Wasl · Sync that asks before it acts.',
  description: 'Pick a folder on your phone and one on Google Drive, and Wasl keeps them in step. It shows every change before the first sync, stops before anything large is deleted, and keeps replaced files for 30 days.',
  h1: 'Sync that asks before it acts.',
  lede: 'Pick a folder on your phone and one on Google Drive, and Wasl keeps them in step. It shows you every change before the first sync, stops before anything large is deleted, and keeps replaced files for 30 days. Your files travel between your phone and your Drive, and nowhere else.',
  more: 'How it works',
  note: 'Wasl (وصل) means connection: what makes two places one. Its mark is two arrows closing a single loop between the phone and the cloud.',
  hero: [['main', 'Wasl’s Pairs screen: “34 deletions wait for you”, Camera syncing at 62%, and Documents synced'], ['dry-run', 'The first-sync preview for Camera: 334 files to Drive, 0 to the phone, 0 to the bin, and 2 conflicts kept both ways']],
  strengthsLabel: 'Three guarantees',
  strengths: [
    { icon: 'visibility', claim: 'Nothing changes until you’ve seen it.', because: 'every new pair opens on a preview of each upload, download and removal, and the first sync starts only when you tap Start.' },
    { icon: 'delete', claim: 'Large deletions wait for you.', because: 'if a sync would remove more than 20 files or 5% of a folder, it stops and asks. Anything removed or replaced waits in the bin for 30 days.' },
    { icon: 'sync_problem', claim: 'Both edits survive.', because: 'when a file changed on the phone and on Drive, Wasl keeps both copies until you choose. Nothing is overwritten on a guess.' },
  ],
  howEyebrow: 'How it works',
  howTitle: 'One pair, four steps.',
  howLede: 'A pair links one folder on the phone with one folder on Drive, with rules of its own. Make as many as you like, each with its own direction and timing.',
  steps: [
    { key: '01 · Pair', title: 'One folder here, one there.', body: 'Name the pair, choose the phone folder and the Drive folder, then the direction: both ways, phone to Drive, or Drive to phone. Shared drives work too.', screen: 'pair-editor', alt: 'A new pair called Camera: /DCIM/Camera on the phone, My Drive/Photos/Camera on Drive, set to two-way' },
    { key: '02 · Preview', title: 'The first sync, before it runs.', body: 'Wasl counts everything that will happen: how many files go up, how many come down, what goes to the bin and where the conflicts are. Browse the list file by file before you tap Start.', screen: 'dry-run', alt: 'The first-sync preview: 334 to Drive, 0 to the phone, and the file list with what will happen to each' },
    { key: '03 · Rules', title: 'Sync when it suits you.', body: 'Within seconds of a change, or every 15 minutes, with rules such as Wi‑Fi only or only while charging. Mobile data is never used unless you allow it.', screen: 'pair-detail', alt: 'Camera’s pair detail: two-way, instant, Wi‑Fi only on, and approval required for large deletions' },
    { key: '04 · Recover', title: 'Undo is always close.', body: 'Wasl’s bin keeps whatever was removed or replaced for 30 days, from the phone or from Drive, and puts it back in one tap. Drive’s version history for every file is one more tap away.', screen: 'recycle-bin', alt: 'The recycle bin: 41 files kept for 30 days, each with a Restore button' },
  ],
  safetyKicker: 'When a folder suddenly empties',
  safetyTitle: '34 deletions wait for you.',
  safetyBody: 'The Camera folder lost 34 files at once, 6% of it. Wasl stopped, deleted nothing, and asked: restore them on the phone, or delete them from Drive too. Either answer can be undone for 30 days.',
  safety: [['review-deletions', 'Review deletions: “34 files gone from the phone”, “Nothing has been deleted”, and Restore on phone or Delete on Drive too'], ['conflict', 'A conflict in report-final.docx: the phone’s copy and Drive’s side by side, with Keep both']],
  toolsEyebrow: 'Tools',
  toolsTitle: 'For when you want more.',
  toolsLede: 'Encrypted vaults, version history, and diagnostics that explain what happened in plain words. All quiet until you need them.',
  tools: [['vaults', 'Encrypted vaults', 'Vaults: pairs encrypted on the phone before upload, so Drive never sees names or contents'], ['versions', 'Version history', 'Version history for budget-2026.xlsx: seven versions, each with Restore'], ['diagnostics', 'Diagnostics', 'Diagnostics: five of six health checks pass, and the last 24 hours of the log'], ['permissions', 'Permissions', 'What Wasl needs: Google Drive and file access are required; notifications and background work are optional']],
  driveEyebrow: 'Your Google Drive',
  driveTitle: 'How Wasl uses your Google Drive.',
  drive: {
    scopeP1: 'When you add a Google account, Wasl asks for one permission: to see, edit, create and delete files in your Google Drive (',
    scopeP2: ').',
    whyH: 'Why it needs full Drive access',
    why: 'You choose folders that already exist in your Drive, including shared drives and files added from a computer or the web. Narrower permissions reach only files the app created itself, so they could not keep an existing folder in sync.',
    doesH: 'What it does with that access',
    does: [
      'Reads your Drive’s folder list, so you can choose a folder to pair.',
      'Uploads and downloads files inside the folders you paired, and exports Google Docs in them as Word, Excel, PowerPoint or PDF copies on your phone.',
      'Moves files that a sync removes to Drive’s trash, and shows earlier versions so you can restore one.',
      'Reads your storage quota to show how much space is free.',
      'If you browse Drive from the phone’s Files app, opens only the files you open there.',
      'If you turn on configuration backup, saves a small file describing your pairs and settings, never file contents, in your Drive’s hidden app-data folder.',
    ],
    whereH: 'Where your data goes',
    where: 'Files travel directly between your phone and Google’s servers over HTTPS. Wasl has no servers of its own and contains no analytics, advertising or crash-reporting code. Your data is never sold, shared, or used to train AI models.',
    limited1: 'Wasl’s use and transfer of information received from Google APIs adheres to the ',
    limitedLink: 'Google API Services User Data Policy',
    limited2: ', including the Limited Use requirements.',
    revoke1: 'You can remove access at any time: in the app under Accounts › Disconnect, or in your Google Account at ',
    revoke2: '. The details are in the ',
    policy: 'privacy policy',
  },
  privacyEyebrow: 'Privacy',
  privacyTitle: 'Your files go to your Drive, and nowhere else.',
  privacyLede: 'Wasl is a tool, not a service: it runs on your phone, talks to Google directly, and nobody but you knows what you sync.',
  facts: [
    { term: 'Storage', value: 'Your own Google Drive' },
    { term: 'Servers', value: 'None of ours. Files travel between your phone and Google over HTTPS' },
    { term: 'Tracking', value: 'No ads, no analytics, no crash reporting' },
    { term: 'Encryption', value: 'Optional per pair, on the phone, with a passphrase that never leaves it' },
    { term: 'Requires', value: 'Android 11 or later' },
    { term: 'Status', value: 'Beta, with access on request', tone: 'accent' },
  ],
  closingTitle: 'Start with one folder.',
  closingBody: 'The camera is a good place to begin: one pair, one preview, one tap on Start. If you don’t like what the preview shows, nothing has changed.',
};

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Wasl', alternateName: ['وصل', 'Drive Sync'],
  applicationCategory: 'UtilitiesApplication', operatingSystem: 'Android 11+', url: P.url, inLanguage: ['en', 'ar'],
  description: T.description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'SAR' },
  publisher: { '@type': 'Organization', name: 'Kahf Labs', url: KAHF },
};
const D = T.drive;
---
<Base p={P} lang={lang} page="home" title={T.title} description={T.description} jsonLd={jsonLd}>
<main id="main">

<section class="pp-hero" aria-labelledby="hero-title">
  <div class="kf-wrap pp-hero-inner">
    <div class="pp-hero-text">
      <div class="pp-chips"><StatusChip group="release" state="beta" lang={lang} compact /><span class="kf-tag">{ar ? 'أندرويد' : 'Android'}</span><span class="kf-tag">Google Drive</span></div>
      <h1 id="hero-title" class="pp-hero-title">{T.h1}</h1>
      <p class="pp-lede">{T.lede}</p>
      <div class="pp-actions">
        <Button href={GET[lang].href} iconEnd="arrow_forward">{GET[lang].label}</Button>
        <Button href="#how" variant="gray">{T.more}</Button>
      </div>
      <p class="pp-note">{T.note}</p>
    </div>
    <div class="pp-hero-visual">
      <div class="pp-duo">
        {T.hero.map(([s, a]) => <Phone src={s} alt={a} eager />)}
      </div>
    </div>
  </div>
</section>

<Strengths lang={lang} label={T.strengthsLabel} items={T.strengths} />

<section id="how" class="kf-wrap pp-section" aria-labelledby="how-title">
  <SectionHead titleId="how-title" index={ar ? '٠١' : '01'} eyebrow={T.howEyebrow} title={T.howTitle} lede={T.howLede} />
  <Steps lang={lang} steps={T.steps} />
</section>

<section id="safety" class="kf-wrap pp-section" aria-labelledby="safety-title">
  <div class="pp-moment">
    <div class="pp-moment-text">
      <p class="pp-kicker">{T.safetyKicker}</p>
      <h2 id="safety-title" class="pp-moment-title">{T.safetyTitle}</h2>
      <p class="pp-moment-body">{T.safetyBody}</p>
    </div>
    <div class="pp-moment-phones">
      {T.safety.map(([s, a]) => <Phone src={s} alt={a} />)}
    </div>
  </div>
</section>

<section class="kf-wrap pp-section" aria-labelledby="tools-title">
  <SectionHead titleId="tools-title" index={ar ? '٠٢' : '02'} eyebrow={T.toolsEyebrow} title={T.toolsTitle} lede={T.toolsLede} />
  <ul class="pp-gallery" aria-label={T.toolsTitle}>
    {T.tools.map(([s, cap, a]) => <li><Phone src={s} alt={a} sizes="(max-width: 640px) 60vw, 260px" /><span class="pp-cap">{cap}</span></li>)}
  </ul>
</section>

<section id="drive" class="kf-wrap pp-section" aria-labelledby="drive-title">
  <div class="pp-card pp-drive">
    <div class="pp-drive-head">
      <Eyebrow index={ar ? '٠٣' : '03'}>{T.driveEyebrow}</Eyebrow>
      <h2 id="drive-title" class="pp-moment-title">{T.driveTitle}</h2>
    </div>
    <div class="pp-prose">
      <p>{D.scopeP1}<code class="pp-ltr">{scope}</code>{D.scopeP2}</p>
      <h3>{D.whyH}</h3>
      <p>{D.why}</p>
      <h3>{D.doesH}</h3>
      <ul>{D.does.map((x) => <li>{x}</li>)}</ul>
      <h3>{D.whereH}</h3>
      <p>{D.where}</p>
      <p>{D.limited1}<a href={policy} rel="noopener">{D.limitedLink}</a>{D.limited2}</p>
      <p>{D.revoke1}<a href={perms} rel="noopener" class="pp-ltr">myaccount.google.com/permissions</a>{D.revoke2}<a href={path(P, lang, 'privacy')}>{D.policy}</a>{ar ? '.' : '.'}</p>
    </div>
  </div>
</section>

<section id="privacy" class="kf-wrap pp-section" aria-labelledby="privacy-title">
  <div class="pp-facts">
    <div class="pp-facts-text">
      <Eyebrow index={ar ? '٠٤' : '04'}>{T.privacyEyebrow}</Eyebrow>
      <h2 id="privacy-title" class="pp-moment-title">{T.privacyTitle}</h2>
      <p class="pp-moment-body">{T.privacyLede}</p>
      <a class="ks-out" href={path(P, lang, 'privacy')} style={ar ? 'font-family: var(--font-arabic);' : undefined}>{ar ? 'سياسة الخصوصية' : 'Privacy policy'}<Icon name="arrow_forward" size={18} /></a>
    </div>
    <SpecList items={T.facts} />
  </div>
</section>

<section class="kf-wrap pp-closing" aria-labelledby="closing-title">
  <h2 id="closing-title" class="pp-closing-title">{T.closingTitle}</h2>
  <p class="pp-lede">{T.closingBody}</p>
  <div class="pp-actions">
    <Button href={GET[lang].href} iconEnd="arrow_forward">{GET[lang].label}</Button>
  </div>
</section>

</main>
</Base>
