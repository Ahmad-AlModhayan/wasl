    <!-- Privacy and licences -->
    <string name="settings_privacy_no_ads_title">No ads, no analytics</string>
    <string name="settings_privacy_no_ads_body">Wasl shows no ads and sends no usage data or crash reports anywhere.</string>
    <string name="settings_privacy_direct_title">Files go only to your Drive and your own devices</string>
    <string name="settings_privacy_direct_body">Wasl talks to Google Drive directly, and to your other devices on your own network. There is no other server in between.</string>
    <string name="settings_privacy_backup_title">Your configuration backup</string>
    <string name="settings_privacy_backup_body">Pairs and settings, without any files, go to a hidden app folder in your Drive that only Wasl can read.</string>
    <string name="settings_privacy_sign_in_title">Sign-in</string>
    <string name="settings_privacy_sign_in_body">Google Play services handles sign-in. Wasl never sees your Google password.</string>
    <string name="settings_privacy_location_title">Location</string>
    <string name="settings_privacy_location_body">Used only to read the Wi‑Fi name, when a pair limits syncing to certain networks.</string>
    <string name="settings_licences_intro">Wasl is built with these open-source parts:</string>
    <string name="settings_licence_androidx">AndroidX and Jetpack Compose</string>
    <string name="settings_licence_kotlin">Kotlin, coroutines and serialization</string>
    <string name="settings_licence_dagger">Dagger and Hilt</string>

