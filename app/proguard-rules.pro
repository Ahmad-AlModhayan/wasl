# R8 for release builds (security review S5-1). R8 shrinks and optimizes the libraries; the code
# below is reached by name at run time, so it keeps its names and members.

# The app's own classes. Hilt, Room, WorkManager (HiltWorker), kotlinx.serialization, the
# DocumentsProvider and the manifest components ship or get rules of their own, but the app also
# stores enum names in Room and settings, and nothing here has been run minified on a phone yet.
# Keeping the app whole means R8 can't rename or strip anything it relies on; narrow this once a
# minified build has been exercised on a device.
-keep class com.almodhayan.drivesync.** { *; }

# libwasl's Kotlin bindings (generated by UniFFI, nothing committed). JNA binds the `UniffiLib`
# interface's methods to native symbols by their names, reads `Structure` fields in the order of
# @Structure.FieldOrder by reflection, and calls `Callback` methods from native code: renaming or
# removing any of it breaks every call into the engine at run time, not at build time.
-keep class com.kahflabs.wasl.ffi.** { *; }
-keep class uniffi.** { *; }

# JNA itself: its native dispatcher (libjnidispatch) looks up these classes, fields and methods
# through JNI by name.
-keep class com.sun.jna.** { *; }
-keepclassmembers class * extends com.sun.jna.Structure { *; }
-keepclassmembers class * implements com.sun.jna.Callback { *; }
-keepclassmembers class * implements com.sun.jna.Library { *; }
-dontwarn java.awt.**
-dontwarn com.sun.jna.**

# Annotations (JNA's FieldOrder, Hilt, serialization), generic signatures and inner classes are
# read at run time.
-keepattributes *Annotation*, Signature, InnerClasses, EnclosingMethod, RuntimeVisibleAnnotations

# OkHttp's optional TLS providers, not on Android.
-dontwarn org.bouncycastle.**
-dontwarn org.conscrypt.**
-dontwarn org.openjsse.**
