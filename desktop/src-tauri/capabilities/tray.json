{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray",
  "description": "The tray's popover and flyout (#69): it listens to the daemon's events and calls only the app commands its page uses.",
  "windows": ["tray"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-daemon-state",
    "allow-status",
    "allow-runs",
    "allow-sync-all",
    "allow-set-paused",
    "allow-tray-hide",
    "allow-tray-fit",
    "allow-tray-open",
    "allow-tray-menu"
  ]
}
